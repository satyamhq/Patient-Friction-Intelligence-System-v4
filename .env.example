# PFIS Backend & Full-Stack Environment Variables Template
PORT=5000
NODE_ENV=production

# Production URLs (Set these in Render dashboard)
CLIENT_URL=https://pfis-patient-friction-intelligence.onrender.com
SERVER_URL=https://pfis-patient-friction-intelligence-system.onrender.com
GOOGLE_CALLBACK_URL=https://pfis-patient-friction-intelligence-system.onrender.com/api/auth/google/callback

# JWT & Security
JWT_SECRET=your_strong_production_jwt_secret_here

# Google Cloud OAuth 2.0 Credentials (Backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Google Maps Platform API Key
GOOGLE_MAPS_API_KEY=

# Database Configuration (MongoDB Atlas or self-hosted MongoDB is the ONLY database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pfis?retryWrites=true&w=majority

# ElevenLabs Conversational AI Integration
ELEVENLABS_AGENT_ID=agent_2901m2hw983kfcesprd47f904gbk
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Telephony Gateway (Twilio / Exotel for Outbound Hospital Relay)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# File Upload Limits
MAX_FILE_SIZE_MB=10
